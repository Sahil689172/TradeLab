# Application
APP_NAME=TradeLab
APP_VERSION=0.1.0
APP_DESCRIPTION=TradeLab Quant Engine — Indian Stock Market Analysis Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Storage (Phase A2.1 — Market Data Infrastructure)
METADATA_DATABASE_URL=sqlite:///backend/data/metadata.db
PARQUET_STORAGE_DIR=backend/data/ohlcv
LOG_DIRECTORY=backend/data/logs

# Legacy app database URL (health check; defaults to metadata DB when unset)
DATABASE_URL=sqlite:///backend/data/metadata.db

# Ingestion
BOOTSTRAP_HISTORY_YEARS=10
YFINANCE_TIMEOUT_SECONDS=30
BOOTSTRAP_RATE_LIMIT_SECONDS=0.75
BOOTSTRAP_MAX_RETRIES=3
BOOTSTRAP_RETRY_BASE_DELAY_SECONDS=1.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
